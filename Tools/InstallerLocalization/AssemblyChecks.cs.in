using System;
using System.IO;
using System.Linq;
using System.Reflection;
using System.Runtime.Loader;
using System.Collections.Generic;

class Program
{
    static int Main(string[] args)
    {
        var managed = Path.GetFullPath(args[0]);
        AssemblyLoadContext.Default.Resolving += (_, name) =>
        {
            foreach (var directory in new[] { managed, Path.Combine(managed, "UnityEngine") })
            {
                var path = Path.Combine(directory, name.Name + ".dll");
                if (File.Exists(path)) return AssemblyLoadContext.Default.LoadFromAssemblyPath(path);
            }
            return null;
        };
        var checks = 0;
        foreach (var file in args.Skip(1))
        {
            // Outside Unity there is no InitializeOnLoad dispatcher. Only this pure helper
            // is invoked; no activator or package-installer entry point is called.
            var assembly = AssemblyLoadContext.Default.LoadFromAssemblyPath(Path.GetFullPath(file));
            var type = assembly.GetType("UnisakiStudio.Setup.Language", true);
            const BindingFlags flags = BindingFlags.NonPublic | BindingFlags.Static;
            object Call(string name, params object[] values) => type.GetMethod(name, flags).Invoke(null, values);
            void Check(bool value, string label) { if (!value) throw new Exception(Path.GetFileName(file) + ": " + label); checks++; }
            Check((string)Call("Resolve", "fr", "ja-JP", "Japanese") == "fr", "saved preference priority");
            Check((string)Call("Resolve", "", "en-US", "Japanese") == "ja", "OS instead of editor culture");
            Check((string)Call("Detect", "zh-TW", "Chinese") == "zh-Hant", "Traditional Chinese");
            Check((string)Call("Detect", "zh-CN", "ChineseSimplified") == "zh-Hans", "Simplified Chinese");
            Check((string)Call("Detect", "pt-BR", "Portuguese") == "pt-BR", "Brazilian Portuguese");
            Check((string)Call("Detect", "ta-IN", "Unknown") == "ta", "Indian language from culture");
            Check((string)Call("Detect", "xx-XX", "Unknown") == "en", "unsupported language fallback");
            Check((string)Call("Translate", "ja", "All Packages are Installed!") == "必要なパッケージはすべて導入済みです。", "VPAI message");
            Check((string)Call("Translate", "en", "キャンセル") == "Cancel", "license action");
            Check((string)Call("Translate", "ja", "License installation") == "ライセンスインストール", "license heading");
            Check((string)Call("Translate", "en", "対象: MyAvatar") == "Target: MyAvatar", "dynamic message preserves avatar name");
            Check((string)Call("Translate", "en", "https://example.com/project.json") == "https://example.com/project.json", "URL unchanged");
            Check((string)type.GetField("PreferenceKey", flags).GetRawConstantValue() == "jp.unisakistudio.posingsystem.language", "same key across programs");
            Check((string)Call("Translate", "fr", "KawaiiPosing: Enabled") == "KawaiiPosing: Activé", "translated license status");
            Check((string)Call("Translate", "en", "対象: 有効") == "Target: 有効", "metadata must not be translated");
            Check((string)Call("Translate", "ja", "Version Unity requise : 2022.3+") == "必要なUnityバージョン: 2022.3+", "language change preserves version");
            const string originalWarning = "2件のIKルールを適用しました。\n: LeftArm のHumanoidボーンがありません。";
            var warning = (string)Call("Translate", "en", originalWarning);
            Check(warning == "Applied 2 IK rules.\n: Humanoid bones for LeftArm are missing.", "nested multiline message with an empty rule name");
            Check((string)Call("Translate", "ja", warning) == originalWarning, "nested multiline message returns to Japanese");
            var codes = (string[])type.GetField("Codes", flags).GetValue(null);
            foreach (var code in codes)
                Check(!string.IsNullOrWhiteSpace((string)Call("Translate", code, "Packages to install")), "setup terms in " + code);
            // This pure formatter has no InitializeOnLoad/static installer hooks.
            // Never invoke VpmPackageAutoInstaller itself in the console process.
            var errorType = assembly.GetType("Anatawa12.VpmPackageAutoInstaller.InstallerError", false);
            if (errorType != null)
            {
                const string missing = "package not found: jp.unisakistudio.kawaiiposing version 3.2.x";
                var format = errorType.GetMethod("Message", flags);
                string Error(Exception error, string language) => (string)format.Invoke(null, new object[] { error, language });
                var failure = new Exception(missing);
                foreach (var code in codes)
                {
                    var message = Error(failure, code);
                    var summary = (string)Call("Translate", code, "Error installing packages");
                    var guidance = (string)Call("Translate", code, "Please see console for more details");
                    Check(message.Contains(missing), "original package/version preserved in " + code);
                    Check(message.StartsWith(summary + "\n\n"), "error summary follows " + code);
                    Check(message.EndsWith(guidance), "Console guidance follows " + code);
                    if (code != "en") Check(summary != "Error installing packages" && guidance != "Please see console for more details", "diagnostic has no English fallback in " + code);
                }
                var japanese = Error(failure, "ja");
                var english = Error(failure, "en");
                Check(japanese != english && Error(failure, "ja") == japanese, "error dialog redraws Japanese to English to Japanese without losing details");
                var nested = new Exception("outer context", new Exception(missing));
                Check(Error(nested, "ja").Contains("outer context\n" + missing), "nested failure context preserved");
                var aggregate = new AggregateException("parallel downloads", new Exception(missing), new Exception("HTTP 403: https://example.invalid/feed.json"));
                Check(Error(aggregate, "ja").Contains(missing) && Error(aggregate, "ja").Contains("HTTP 403: https://example.invalid/feed.json"), "every aggregate failure remains visible");
                Check(!Error(null, "ja").Contains("\n\n\n\n"), "missing details retain useful summary and guidance");
            }
            Console.WriteLine(Path.GetFileName(file) + ": " + checks + " cumulative checks passed");
        }
        Console.WriteLine("PASSED " + checks);
        return 0;
    }
}
